# ============================================================
# Saraswati — Root .env.example
# ============================================================
# This file lists ALL environment variables used across the project.
# Each app directory (backend/, apps/web/, apps/mobile/) also has
# its own .env.example with only the variables relevant to that app.
#
# Copy to .env and fill in real values. NEVER commit real secrets.
# See docs/18-ENVIRONMENT-VARIABLES.md for full documentation.
# ============================================================

# -----------------------------------------------------------
# Backend (backend/.env)
# -----------------------------------------------------------

# Environment: development | staging | production
ENVIRONMENT=development

# Enable verbose error output (MUST be false outside local dev)
DEBUG=true

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase project URL
SUPABASE_URL=https://[PROJECT_REF].supabase.co

# Supabase service-role key (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret (for verifying user JWTs)
SUPABASE_JWT_SECRET=

# Razorpay API credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase service account JSON (path or inline JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Resend API key for transactional emails
RESEND_API_KEY=

# Google Maps server-side API key (if used for geocoding)
GOOGLE_MAPS_SERVER_API_KEY=

# CORS: comma-separated allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public URL of the web app (used in email links)
APP_BASE_URL=http://localhost:3000

# Logging level: debug | info | warning | error
LOG_LEVEL=info

# Rate limiting default (requests per minute per IP)
RATE_LIMIT_DEFAULT=60

# -----------------------------------------------------------
# Web Frontend (apps/web/.env.local)
# -----------------------------------------------------------

# FastAPI backend base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Supabase public values (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay public key ID (safe to expose — NOT the secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google Maps browser API key (must be referrer-restricted in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=

# App environment identifier
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------
# Mobile (apps/mobile/ — via app.config.ts / EAS secrets)
# -----------------------------------------------------------

# FastAPI backend base URL
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Supabase public values
EXPO_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay public key ID
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Note: google-services.json is bundled at build time via EAS, not an env var
