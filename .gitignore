# ============================================================
# Saraswati .gitignore
# ============================================================

# ---- Environment & Secrets (NEVER commit these) ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# ---- Python / Backend ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/
*.egg
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.coveragerc
alembic/versions/__pycache__/

# ---- Node / Frontend ----
node_modules/
.next/
.expo/
.expo-shared/
dist/
out/
.output/

# ---- pnpm ----
.pnpm-store/
.pnpm-debug.log*

# ---- npm / yarn logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- OS & Editor ----
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/settings.json
*.swp
*.swo

# ---- Mobile ----
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
google-services.json
GoogleService-Info.plist

# ---- Supabase local ----
.supabase/

# ---- Misc ----
*.log
*.pid
*.seed
*.pid.lock
.nyc_output/
