# ============================================================
# backend/.env.example — Backend Environment Variables
# ============================================================
# Copy this to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# See docs/18-ENVIRONMENT-VARIABLES.md for full documentation.
# ============================================================

# App
ENVIRONMENT=development
DEBUG=true
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_DEFAULT=60

# Database — Supabase PostgreSQL connection string
# For local dev, use your Supabase dev project's connection string (port 6543 for pooler)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # Full-privilege key — BACKEND ONLY, never frontend
SUPABASE_JWT_SECRET=              # Found in Supabase project Settings → API → JWT Secret

# Razorpay (use test-mode keys in development/staging)
RAZORPAY_KEY_ID=                  # rzp_test_... in test mode
RAZORPAY_KEY_SECRET=              # Never expose this
RAZORPAY_WEBHOOK_SECRET=          # Set in Razorpay dashboard → Webhooks

# Firebase FCM (backend service account)
FIREBASE_SERVICE_ACCOUNT_JSON=    # JSON string or path to file

# Resend (transactional email)
RESEND_API_KEY=                   # re_... key from Resend dashboard

# Google Maps (server-side geocoding — optional)
GOOGLE_MAPS_SERVER_API_KEY=       # Restrict this key to server-side only

# CORS — comma-separated allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
